---
import { getEntry, render } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import BackLink from "../components/ui/BackLink.astro";
import Tag from "../components/ui/Tag.astro";
import Icon from "../components/ui/Icon.astro";
import { getDetailItem } from "../utils/adapters";
import { SITE, PAGES } from "../config";

interface Props {
    collection: "publications" | "talks" | "projects" | "posts" | "teaching" | "server";
    id: string;
    backHref?: string;   // override the default back link (e.g. a sub-section)
    backLabel?: string;
}

const { collection, id, backHref, backLabel } = Astro.props;
const entry = (await getEntry(collection, id)) as any;

if (!entry) return Astro.redirect("/404");

const { Content, headings } = await render(entry);
const guideHeadings = collection === "server" ? headings.filter((h) => h.depth === 2) : [];
const detail = getDetailItem(entry, collection);
const isKorean = collection === "server" && entry.data.language === "ko";
if (collection === "server" && entry.data.date) {
    detail.date = new Intl.DateTimeFormat(isKorean ? "ko-KR" : "en-US", {
        year: "numeric", month: "long", day: "numeric", timeZone: "UTC",
    }).format(new Date(`${entry.data.date}T00:00:00Z`));
}

const meta = [];
if (detail.date) meta.push({ label: "Date", value: detail.date, icon: "Calendar" });
if (detail.authors) meta.push({ label: "Author", value: detail.authors, icon: "User" });
if (detail.extraInput) {
    const icon = "Institution";
    const label = collection === "publications" ? "Journal" : collection === "talks" ? "Event" : collection === "teaching" ? "Institution" : "Info";
    meta.push({ label, value: detail.extraInput, icon });
}

const description = entry.data.description || detail.description || SITE.desc;
const ogImage = entry.data.image || SITE.ogImage;
---

<BaseLayout title={detail.title} description={description} ogImage={ogImage} ogType="article">
    <slot name="header" />
    <div class="flex justify-between items-center mb-4">
        <BackLink href={backHref ?? detail.backHref} label={backLabel ?? (PAGES[collection === "posts" ? "blog" : collection]?.title ?? collection).toLowerCase()} language={isKorean ? "ko" : "en"} />
        {detail.externalUrl && (
            <a href={detail.externalUrl} target="_blank" rel="noopener noreferrer" class="link">
                View external
            </a>
        )}
    </div>

    <article>
        <h1 class="page-title mb-4">{detail.title}</h1>

        {meta.length > 0 && (
            <div class="card-meta mb-4">
                {meta.map((m: any) => (
                    <span class="flex items-center gap-1">
                        <Icon name={m.icon} size={14} />
                        <span>{m.value}</span>
                    </span>
                ))}
            </div>
        )}

        {detail.tags && detail.tags.length > 0 && (
            <div class="flex gap-2 flex-wrap mb-4">
                {detail.tags.map((tag: string) => (
                    <Tag name={tag} size="sm" />
                ))}
            </div>
        )}

        {entry.data.image && (
            <figure class="detail-figure">
                <img src={entry.data.image} alt={`Figure for ${detail.title}`} decoding="async" />
            </figure>
        )}

        {guideHeadings.length > 0 && (
            <nav class="guide-toc" aria-label={isKorean ? "이 페이지 목차" : "On this page"}>
                <h2>{isKorean ? "이 페이지에서" : "On this page"}</h2>
                <ul>
                    {guideHeadings.map((heading) => (
                        <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
                    ))}
                </ul>
            </nav>
        )}

        <div class:list={["prose", { "server-guide": collection === "server" }]}>
            <Content />
        </div>

        <slot name="share" />
        <slot name="footer" />
    </article>
</BaseLayout>
