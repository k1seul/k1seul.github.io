---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BaseItemCard from "../ui/BaseItemCard.astro";
import ServerTabs from "../ui/ServerTabs.astro";
import ServerLanguageSwitch from "../ui/ServerLanguageSwitch.astro";
import { SERVER_COPY, getServerSections, serverHref, type ServerLanguage, type ServerSectionId } from "../../config/server";
import { getServerGuides, serverGuideHref } from "../../utils/serverGuides";

interface Props { section: ServerSectionId; language?: ServerLanguage; }
const { section, language = "en" } = Astro.props;
const copy = SERVER_COPY[language];
const meta = getServerSections(language).find((s) => s.id === section)!;
const guides = await getServerGuides(language, section);
const quickIds = section === "laal" ? ["getting-started", "slurm", "faq"] : ["gsds-overview", "gsds-access", "gsds-operations"];
---

<BaseLayout title={section === "laal" ? copy.title : meta.label + " | " + copy.title} description={meta.intro}>
    <header class="page-header">
        <h1 class="page-title">{copy.title}</h1>
        <p class="page-subtitle">{copy.subtitle}</p>
    </header>
    <ServerLanguageSwitch language={language} />
    <ServerTabs active={section} language={language} />
    <p class="callout">{meta.intro}</p>
    <nav aria-label={copy.quickNav} class="flex flex-wrap gap-2 mb-8">
        {quickIds.map((id, i) => (
            <a class="btn btn-sm" href={serverHref("/server/" + id, language)}>{copy.quick[section][i]}</a>
        ))}
    </nav>
    <section class="item-list">
        {guides.map((guide, i) => (
            <BaseItemCard title={i + 1 + ". " + guide.data.title} href={serverGuideHref(guide)} description={guide.data.description} />
        ))}
    </section>
</BaseLayout>

