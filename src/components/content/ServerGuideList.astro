---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BaseItemCard from "../ui/BaseItemCard.astro";
import ServerTabs from "../ui/ServerTabs.astro";
import { PAGES } from "../../config";
import { SERVER_SECTIONS } from "../../config/server";

interface Props {
    section: string;
}

const { section } = Astro.props;
const meta = SERVER_SECTIONS.find((s) => s.id === section) ?? SERVER_SECTIONS[0];

const guides = (await getCollection("server"))
    .filter((g) => g.data.section === section)
    .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={section === "laal" ? PAGES.server.title : `${meta.label} | ${PAGES.server.title}`}>
    <header class="page-header">
        <h1 class="page-title">{PAGES.server.title}</h1>
        {PAGES.server.subtitle && <p class="page-subtitle">{PAGES.server.subtitle}</p>}
    </header>

    <ServerTabs active={section} />

    <p class="callout">{meta.intro}</p>

    <nav aria-label="빠른 안내" class="flex flex-wrap gap-2 mb-8">
        {section === "laal" ? (
            <>
                <a class="btn btn-sm" href="/server/getting-started">처음 시작하기</a>
                <a class="btn btn-sm" href="/server/slurm">GPU 작업 실행</a>
                <a class="btn btn-sm" href="/server/faq">문제 해결</a>
            </>
        ) : (
            <>
                <a class="btn btn-sm" href="/server/gsds-overview">진행 상태·구성</a>
                <a class="btn btn-sm" href="/server/gsds-access">이용 신청 계획</a>
                <a class="btn btn-sm" href="/server/gsds-operations">관리자 체크리스트</a>
            </>
        )}
    </nav>

    <section class="item-list">
        {guides.map((guide, i) => (
            <BaseItemCard
                title={`${i + 1}. ${guide.data.title}`}
                href={`/server/${guide.id}`}
                description={guide.data.description}
            />
        ))}
    </section>
</BaseLayout>

