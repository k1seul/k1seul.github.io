---
import { NAV_LINKS, PAGES } from "../../config";

const currentPath = Astro.url.pathname;
const isKoreanGuide = /^\/ko\/server(?:\/|$)/.test(currentPath);
const koreanLabels: Record<string, string> = {
    "/": "소개", "/publications": "논문", "/projects": "학습 기록", "/seminar": "세미나",
    "/posts": "블로그", "/talks": "발표", "/teaching": "강의",
    "/tags": "태그", "/cv": "이력", "/server": "서버 안내",
};
---

<nav class="navbar">
    <ul class="nav-links">
        {
            NAV_LINKS.filter((link) => {
                const isHome = link.href === "/";
                const section = link.href.split("/").filter(Boolean)[0];
                const pageKey = isHome
                    ? "home"
                    : section === "posts"
                      ? "blog"
                      : section;
                const pageConfig = (PAGES as any)[pageKey];
                return link.isActive !== false && pageConfig?.isActive !== false;
            }).map((link) => (
                <li>
                    <a
                        href={isKoreanGuide && link.href === "/server" ? "/ko/server" : link.href}
                        class={`nav-link ${
                            (isKoreanGuide && link.href === "/server") || currentPath === link.href ||
                            (link.href !== "/" &&
                                currentPath.startsWith(link.href))
                                ? "active"
                                : "inactive"
                        }`}
                    >
                        {isKoreanGuide ? (koreanLabels[link.href] ?? link.label) : link.label}
                        <span class="nav-link-line" />
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

