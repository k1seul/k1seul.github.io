---
import { getServerSections, type ServerLanguage } from "../../config/server";

interface Props {
    active: string;
    language?: ServerLanguage;
}

const { active, language = "en" } = Astro.props;
---

<nav class="section-tabs" aria-label={language === "ko" ? "서버 안내 구분" : "Server guide sections"}>
    {getServerSections(language).map((s) => (
        <a
            href={s.href}
            class={s.id === active ? "section-tab section-tab-active" : "section-tab"}
            aria-current={s.id === active ? "page" : undefined}
        >
            {s.label}
        </a>
    ))}
</nav>

